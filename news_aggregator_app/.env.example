# Copy this file to ".env" and fill in your Supabase project credentials to
# switch Pulse's storage backend from local SQLite to hosted Postgres.
#
# Get these from your Supabase project: Project Settings -> API.
# SUPABASE_SERVICE_KEY is the SECRET "service_role" key (NOT the public
# "anon" key) — it must never be committed or exposed to the browser.
# Leave both blank / delete this file to keep using local SQLite (pulse.db).

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
